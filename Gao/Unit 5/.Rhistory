estimate_pi <- function(num_points) {
inside_circle <- 0
x_values <- c()
y_values <- c()
pb <- progress_bar$new(
format = "[:bar] :percent ETA: :eta",
total = num_points,
clear = FALSE
)
for (i in 1:num_points) {
x <- runif(1, 0, 1)
y <- runif(1, 0, 1)
x_values <- c(x_values, x)
